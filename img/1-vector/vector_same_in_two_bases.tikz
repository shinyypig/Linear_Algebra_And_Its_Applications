\begin{tikzpicture}[
        axis/.style={
                black,
                semithick,
                -latex,
            },
        rotated axis/.style={
                black,
                semithick,
                -latex,
            },
        vector/.style={
                c1,
                thick,
                -latex,
            },
        projection/.style={black, densely dashed, semithick},
        tick/.style={black, semithick},
        ]
    % Standard Cartesian coordinate system.
    \draw[axis] (-2,0) -- (2,0)
    node[below right=-1pt, text=black] {\(x\)};
    \draw[axis] (0,-2) -- (0,2)
    node[above, text=black] {\(y\)};

    % Coordinate system obtained by rotating the standard axes by 45 degrees.
    \draw[rotated axis] (-2/1.414,-2/1.414) -- (2/1.414,2/1.414)
    node[above=2pt, text=black] {\(x'\)};
    \draw[rotated axis] (2/1.414,-2/1.414) -- (-2/1.414,2/1.414)
    node[above left=-1pt, text=black] {\(y'\)};

    % The same geometric vector and its projections in the standard basis.
    \draw[projection] (1,0) -- (1,1) -- (0,1);
    \draw[tick] (1,-.045) -- (1,.045);
    \draw[tick] (-.045,1) -- (.045,1);
    \node[font=\scriptsize, text=black, below=2pt] at (1,0) {\(1\)};
    \node[font=\scriptsize, text=black, left=2pt] at (0,1) {\(1\)};

    \draw[vector] (0,0) -- (1,1);
    \node[font=\small\bfseries, text=black] at (1.18,.83) {\(\bm v\)};

    % Rotation angle and the x'-coordinate of the vector.
    \draw[c2, semithick]
    (.39,0) arc[start angle=0,end angle=45,radius=.39];

    \fill[black] (0,0) circle (1pt);
    \node[font=\scriptsize, below left=2pt, text=black] at (0,0) {\(O\)};
\end{tikzpicture}
