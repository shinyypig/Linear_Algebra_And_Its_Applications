\begin{tikzpicture}
    \begin{axis}[
            view={45}{20},
            width=4.5cm,
            xlabel={\(x\)},
            ylabel={\(y\)},
            zlabel={\(z\)},
            ticklabel style={font=\tiny, text=black},
            label style={font=\small, text=black},
            xmin=-2.5, xmax=2.5,
            ymin=-2.5, ymax=2.5,
            zmin=-2, zmax=2,
            axis lines=center,
            axis line style={black, semithick, -latex},
            axis equal image,
            xtick=\empty, ytick=\empty, ztick=\empty,
            clip=false,
        ]
        % Origin
        \addplot3[only marks, mark=*, mark size=0.8pt, black, forget plot]
        coordinates {(0,0,0)};
        \node[font=\scriptsize, text=black, anchor=north east]
        at (axis cs:0,0,0) {\(O\)};

        % Dashed line through origin in direction v = (1,1,1.5)
        % Endpoints at z boundary (z=1.5t=±2 => t=±4/3≈1.334), clipped by pgfplots
        \addplot3[black, semithick, densely dashed, forget plot]
        coordinates {(-1.2,-1.2,-1.8) (1.2,1.2,1.8)};

        % Vector v
        \addplot3[c1, thick, -latex, forget plot]
        coordinates {(0,0,0) (1,1,1.5)};
        \node[font=\small, text=black, anchor=west] at (axis cs:1.1,1.1,1.6) {\(\bm{v}\)};
    \end{axis}
\end{tikzpicture}
