\begin{tikzpicture}[
        vertex/.style={
                circle,
                draw=c1,
                fill=white,
                text=c1!70!black,
                thick,
                minimum size=4.2mm,
                inner sep=0pt,
                font=\scriptsize\bfseries,
            },
        square/.style={
                draw=black!70,
                fill=c1!5,
                thick,
            },
        symmetry axis/.style={
                c2,
                dashed,
                thick,
            },
        rotation arrow/.style={
                c2,
                thick,
                -{Stealth[length=3pt,width=3pt]},
            },
        rotation guide/.style={
                black!60,
                thin,
            },
        operation label/.style={
                font=\scriptsize,
                text=black,
                align=center,
            },
    ]
    \newcommand{\symmetrysquare}[5]{%
        \draw[square] (-.78,-.78) rectangle (.78,.78);
        \node[vertex] at (-.78,.78) {#2};
        \node[vertex] at (.78,.78) {#3};
        \node[vertex] at (.78,-.78) {#4};
        \node[vertex] at (-.78,-.78) {#5};
        \node[operation label] at (0,-1.18) {#1};
    }

    % Four rotations.
    \begin{scope}[shift={(0,2.55)}]
        \symmetrysquare{旋转 \(0^\circ\)}{1}{2}{3}{4}
        \node[font=\small,text=c2] at (0,0) {\(e\)};
    \end{scope}
    \begin{scope}[shift={(3.1,2.55)}]
        \symmetrysquare{旋转 \(90^\circ\)}{4}{1}{2}{3}
        \draw[rotation guide] (90:.42) arc[start angle=90,delta angle=-360,radius=.42];
        \draw[rotation arrow] (90:.42) arc[start angle=90,delta angle=-90,radius=.42];
    \end{scope}
    \begin{scope}[shift={(6.2,2.55)}]
        \symmetrysquare{旋转 \(180^\circ\)}{3}{4}{1}{2}
        \draw[rotation guide] (90:.42) arc[start angle=90,delta angle=-360,radius=.42];
        \draw[rotation arrow] (90:.42) arc[start angle=90,delta angle=-180,radius=.42];
    \end{scope}
    \begin{scope}[shift={(9.3,2.55)}]
        \symmetrysquare{旋转 \(270^\circ\)}{2}{3}{4}{1}
        \draw[rotation guide] (90:.42) arc[start angle=90,delta angle=-360,radius=.42];
        \draw[rotation arrow] (90:.42) arc[start angle=90,delta angle=-270,radius=.42];
    \end{scope}

    % Four reflections.
    \begin{scope}[shift={(0,0)}]
        \symmetrysquare{关于竖直轴反射}{2}{1}{4}{3}
        \draw[symmetry axis] (0,-1) -- (0,1);
    \end{scope}
    \begin{scope}[shift={(3.1,0)}]
        \symmetrysquare{关于对角线 \(24\) 反射}{3}{2}{1}{4}
        \draw[symmetry axis] (-.58,-.58) -- (.58,.58);
    \end{scope}
    \begin{scope}[shift={(6.2,0)}]
        \symmetrysquare{关于水平轴反射}{4}{3}{2}{1}
        \draw[symmetry axis] (-1,0) -- (1,0);
    \end{scope}
    \begin{scope}[shift={(9.3,0)}]
        \symmetrysquare{关于对角线 \(13\) 反射}{1}{4}{3}{2}
        \draw[symmetry axis] (-.58,.58) -- (.58,-.58);
    \end{scope}
\end{tikzpicture}
