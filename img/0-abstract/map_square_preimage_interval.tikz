\begin{tikzpicture}
    \begin{axis}[
            width=6cm,
            height=5cm,
            xlabel=\(x\), ylabel=\(f(x)\),
            xmin=-2, xmax=2,
            ymin=-1.2, ymax=4.2,
            ticklabel style={font=\scriptsize},
            axis equal image,
            axis lines=middle,
            label style={font=\small},
        ]
        \addplot[
            c2,
            fill=c2,
            fill opacity=0.1,
            draw=none,
            forget plot,
        ] coordinates {(-2,-1.2) (2,-1.2) (2,0) (-2,0)} -- cycle;
        \addplot[
            c1,
            thick,
            samples=100,
            domain=-2:2,
        ] {x^2};

        \addplot[
            fill=c5,
            fill opacity=0.18,
            draw=none,
            samples=80,
            domain=-1.5:-1,
            forget plot,
        ] {x^2} \closedcycle;
        \addplot[
            fill=c5,
            fill opacity=0.18,
            draw=none,
            samples=80,
            domain=1:1.5,
            forget plot,
        ] {x^2} \closedcycle;

        \addplot[
            fill=c5,
            fill opacity=0.18,
            draw=none,
            forget plot,
        ] coordinates {
                (-1,1)
                (-1.05,1.1025)
                (-1.10,1.21)
                (-1.15,1.3225)
                (-1.20,1.44)
                (-1.25,1.5625)
                (-1.30,1.69)
                (-1.35,1.8225)
                (-1.40,1.96)
                (-1.45,2.1025)
                (-1.5,2.25)
                (1.5,2.25)
                (1.45,2.1025)
                (1.40,1.96)
                (1.35,1.8225)
                (1.30,1.69)
                (1.25,1.5625)
                (1.20,1.44)
                (1.15,1.3225)
                (1.10,1.21)
                (1.05,1.1025)
                (1,1)
            } -- cycle;

        \addplot[
            c1,
            thick,
            samples=100,
            domain=-2:2,
        ] {x^2};
        \addplot[
            c1,
            thick,
            only marks,
            mark=*,
            fill=c1!60,
            mark size=1.6pt,
            forget plot,
        ] coordinates {(-1,1) (1,1) (-1.5,2.25) (1.5,2.25)};
        \addplot[
            dashed,
            thick,
            forget plot,
        ] coordinates {(-1,0) (-1,1) (1,1) (1,0)};
        \addplot[
            dashed,
            thick,
            forget plot,
        ] coordinates {(-1.5,0) (-1.5,2.25) (1.5,2.25) (1.5,0)};
    \end{axis}
\end{tikzpicture}
