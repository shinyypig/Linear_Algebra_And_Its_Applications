\begin{tikzpicture}
    \begin{axis}[
            width=6cm,
            height=5cm,
            xlabel=$x$, ylabel=$f(x)$,
            xmin=-2, xmax=2,
            ymin=-1.2, ymax=4.2,
            ticklabel style={font=\scriptsize},
            axis equal image,
            axis lines=middle,
            axis line style={-Stealth},
            label style={font=\small},
        ]
        \addplot[
            c2,
            fill=c2,
            fill opacity=0.1,
            draw=none,
            forget plot,
        ] coordinates {(-2,-1.2) (2,-1.2) (2,0) (-2,0)} -- cycle;
        \addplot[
            c1,
            thick,
            samples=100,
            domain=-2:2,
        ] {x^2};
        \addplot[
            c1,
            thick,
            only marks,
            mark=*,
            fill=c1!60,
            mark size=1.6pt,
            forget plot,
        ] coordinates {(-1,1) (1,1)};
        \addplot[
            dashed,
            thick,
            forget plot,
        ] coordinates {(-1,1) (1,1)};
        \addplot[
            dashed,
            thick,
            forget plot,
        ] coordinates {(-1,1) (-1,0)};
        \addplot[
            dashed,
            thick,
            forget plot,
        ] coordinates {(1,1) (1,0)};
    \end{axis}
\end{tikzpicture}
