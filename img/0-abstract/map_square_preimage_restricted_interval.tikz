\begin{tikzpicture}
    \begin{axis}[
            width=6cm,
            height=5cm,
            xlabel=\(x\), ylabel=\(f(x)\),
            xmin=-2, xmax=2,
            ymin=-1.2, ymax=4.2,
            ticklabel style={font=\scriptsize},
            axis equal image,
            axis lines=middle,
            label style={font=\small},
        ]
        \addplot[
            c2,
            fill=c2,
            fill opacity=0.1,
            draw=none,
            forget plot,
        ] coordinates {(-2,-1.2) (2,-1.2) (2,0) (-2,0)} -- cycle;
        \addplot[
            c2,
            fill=c2,
            fill opacity=0.1,
            draw=none,
            forget plot,
        ] coordinates {(-2,0) (-2,4) (0,4) (0,0)} -- cycle;
        \addplot[
            c1,
            thick,
            samples=100,
            domain=0:2,
        ] {x^2};

        \addplot[
            fill=c5,
            fill opacity=0.18,
            draw=none,
            samples=80,
            domain=1:1.5,
            forget plot,
        ] {x^2} \closedcycle;

        \path[
            fill=c5,
            fill opacity=0.18,
            draw=none,
        ]
        (axis cs:0,1) -- (axis cs:1,1)
        plot[domain=1:1.5,samples=80] (axis cs:\x,{\x*\x}) -- (axis cs:0,2.25) -- (axis cs:0,1) -- cycle;

        \addplot[
            c1,
            thick,
            samples=100,
            domain=0:2,
        ] {x^2};
        \addplot[
            dashed,
            thick,
            forget plot,
        ] coordinates {(1,0) (1,1) (0,1)};
        \addplot[
            dashed,
            thick,
            forget plot,
        ] coordinates {(1.5,0) (1.5,2.25) (0,2.25)};
        \addplot[
            c1,
            thick,
            only marks,
            mark=*,
            fill=c1!60,
            mark size=1.6pt,
            forget plot,
        ] coordinates {(0,0) (1,1) (1.5,2.25)};
    \end{axis}
\end{tikzpicture}
