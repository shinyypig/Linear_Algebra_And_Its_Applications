\begin{tikzpicture}
    \begin{axis}[
            width=6cm,
            height=5cm,
            xlabel={\(x\)},
            ylabel={\(f(x)\)},
            xmin=-2, xmax=2,
            ymin=-1.2, ymax=4.2,
            ticklabel style={font=\scriptsize, text=black},
            axis equal image,
            axis lines=middle,
            axis line style={black, semithick, -latex},
            label style={font=\small, text=black},
            xlabel style={anchor=west},
            ylabel style={anchor=south},
        ]
        \addplot[
            c1,
            thick,
            samples=100,
            domain=-2:2,
            forget plot,
        ] {x^2};
    \end{axis}
\end{tikzpicture}
